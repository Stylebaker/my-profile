let gs = {};

function getClass(name) { return CHARS[name].class; }
function isHeavy(n) { return CHARS[n].class === 'Brute/Heavy'; }
function isKnight(n) { return CHARS[n].class === 'Knight'; }
function isGuard(n) { return CHARS[n].class === 'Guard'; }
function isRogue(n) { return CHARS[n].class === 'Rogue'; }
function rand(arr) { return arr[Math.floor(Math.random()*arr.length)]; }
function rollD6() { return Math.floor(Math.random()*6)+1; }
function rollD20() { return Math.floor(Math.random()*20)+1; }

let selectedChar = null;

function selectChar(name) {
  if(selectedChar) document.getElementById('card-'+selectedChar).classList.remove('selected');
  selectedChar = name;
  document.getElementById('card-'+name).classList.add('selected');
  document.getElementById('start-btn').disabled = false;
}

function startGame() {
  if(!selectedChar) return;
  const c = CHARS[selectedChar];
  gs = { name: selectedChar, charClass: c.class, hp: c.hp, maxHp: c.hp, gold: 10, inventory: [], chapter: 0, flags: {} };
  document.getElementById('title-screen').style.display = 'none';
  document.getElementById('game-panel').style.display = 'block';
  updateHUD();
  loadScene('start');
}

function updateHUD() {
  document.getElementById('hud-name').textContent = gs.name;
  document.getElementById('hud-class').textContent = gs.charClass;
  document.getElementById('gold-count').textContent = '⬡ '+gs.gold;
  const hb = document.getElementById('health-bar');
  hb.innerHTML = '';
  for(let i=0;i<gs.maxHp;i++){
    const pip = document.createElement('div');
    pip.className = 'health-pip'+(i<gs.hp?' alive':'');
    hb.appendChild(pip);
  }
  if(gs.inventory.length>0){
    document.getElementById('inv-display').style.display='block';
    document.getElementById('inv-row').innerHTML = gs.inventory.map(i=>`<span class="inv-item">${i}</span>`).join('');
  } else {
    document.getElementById('inv-display').style.display='none';
  }
}

function damage(n) {
  gs.hp = Math.max(0, gs.hp-n);
  updateHUD();
  if(gs.hp<=0){ setTimeout(()=>loadScene('death'),800); return true; }
  return false;
}
function heal(n) { gs.hp = Math.min(gs.maxHp, gs.hp+n); updateHUD(); }
function addGold(n) { gs.gold += n; updateHUD(); }
function addItem(item) { if(!gs.inventory.includes(item)) gs.inventory.push(item); updateHUD(); }
function hasItem(item) { return gs.inventory.includes(item); }

function renderScene(scene) {
  const container = document.getElementById('scene-container');
  let html = `<div class="scene-panel fade-in">`;
  if(scene.badge) html += `<div class="encounter-badge badge-${scene.badge}">${scene.badgeText||scene.badge}</div><br>`;
  if(scene.location) html += `<div class="scene-location">${scene.location}</div>`;
  html += `<div class="scene-text">${scene.text}</div></div>`;
  html += `<div class="choices fade-in">`;
  scene.choices.forEach((ch,i)=>{
    const letters = ['I','II','III','IV','V'];
    const disabled = ch.requires && !meetsRequirement(ch.requires) ? 'disabled title="Your class cannot do this"' : '';
    html += `<button class="choice-btn" onclick="chooseOption(${i})" ${disabled}>
      <span class="choice-letter">${letters[i]||i+1}</span>
      <div><div>${ch.text}</div>${ch.hint?`<div class="choice-hint">${ch.hint}</div>`:''}</div>
    </button>`;
  });
  html += `</div>`;
  container.innerHTML = html;
  container.scrollIntoView({behavior:'smooth',block:'start'});
  window._currentScene = scene;
}

function meetsRequirement(req) {
  if(req==='heavy') return isHeavy(gs.name)||isKnight(gs.name);
  if(req==='sneak') return isRogue(gs.name);
  if(req==='guard') return isGuard(gs.name)||isKnight(gs.name);
  if(req==='rogue') return isRogue(gs.name);
  if(req==='knight') return isKnight(gs.name)||isGuard(gs.name);
  return true;
}

function chooseOption(idx) {
  const ch = window._currentScene.choices[idx];
  if(ch.action) ch.action();
  else if(ch.next) loadScene(ch.next);
}

function showOutcome(badge,badgeText,location,mainText,outcomeType,outcomeText,choices) {
  renderScene({
    badge,badgeText,location,
    text: mainText+'<div class="outcome-'+outcomeType+'" style="margin-top:14px;">'+outcomeText+'</div>',
    choices
  });
}

