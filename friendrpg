<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chronicles of Fate</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap');

  :root {
    --bg: #0d0a07;
    --bg2: #131009;
    --panel: #1a1410;
    --border: #4a3520;
    --gold: #c9943a;
    --gold-light: #e8b84b;
    --red: #8b2020;
    --red-light: #c0392b;
    --green: #2d5a1b;
    --green-light: #4a8a2a;
    --text: #d4c4a0;
    --text-dim: #8a7a5a;
    --white: #f0e8d0;
    --shadow: rgba(0,0,0,0.7);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 18px;
    line-height: 1.7;
    min-height: 100vh;
    background-image:
      radial-gradient(ellipse at top, #1a1205 0%, #0d0a07 60%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%234a3520' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  #app {
    max-width: 780px;
    margin: 0 auto;
    padding: 20px;
  }

  #title-screen {
    text-align: center;
    padding: 60px 20px;
  }

  .title-rune {
    font-size: 48px;
    color: var(--gold);
    letter-spacing: 20px;
    margin-bottom: 10px;
    opacity: 0.6;
  }

  h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(36px, 8vw, 64px);
    font-weight: 900;
    color: var(--gold-light);
    text-shadow: 0 0 40px rgba(201,148,58,0.4), 0 2px 4px #000;
    letter-spacing: 4px;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .subtitle {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    color: var(--text-dim);
    letter-spacing: 6px;
    text-transform: uppercase;
    margin-bottom: 50px;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 24px 0;
    position: relative;
  }
  .divider::before {
    content: '⬥';
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg);
    padding: 0 10px;
    color: var(--gold);
    font-size: 12px;
  }

  .section-title {
    font-family: 'Cinzel', serif;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 20px;
    text-align: center;
  }

  .class-group { margin-bottom: 30px; }

  .class-label {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .class-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .char-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .char-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 14px 16px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }
  .char-card:hover {
    border-color: var(--gold);
    background: #211a10;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(201,148,58,0.15);
  }
  .char-card.selected {
    border-color: var(--gold-light);
    background: #251d0f;
    box-shadow: 0 0 0 1px var(--gold-light), 0 4px 20px rgba(201,148,58,0.2);
  }

  .char-name {
    font-family: 'Cinzel', serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 4px;
  }

  .char-stats {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .stat-bar {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  .stat-pip {
    width: 12px;
    height: 6px;
    border-radius: 1px;
    background: #2a2015;
    border: 1px solid #3a2d18;
  }
  .stat-pip.filled { background: var(--gold); border-color: var(--gold-light); }
  .stat-pip.red-fill { background: var(--red-light); border-color: #e05050; }
  .stat-pip.green-fill { background: var(--green-light); border-color: #6ab040; }

  #game-panel { display: none; }

  .hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hud-name {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    color: var(--gold-light);
    font-weight: 700;
  }

  .hud-right {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .health-bar {
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .health-pip {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    background: #2a1515;
    border: 1px solid #3a1a1a;
    transition: all 0.3s;
  }
  .health-pip.alive { background: var(--red-light); border-color: #e05050; }

  .hud-tag {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--text-dim);
    text-transform: uppercase;
    font-family: 'Cinzel', serif;
  }

  .gold-count {
    font-family: 'Cinzel', serif;
    font-size: 13px;
    color: var(--gold);
  }

  .scene-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 28px 32px;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }

  .scene-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .scene-location {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 14px;
    opacity: 0.8;
  }

  .scene-text {
    font-size: 18px;
    color: var(--text);
    line-height: 1.75;
    font-style: italic;
  }

  .scene-text strong {
    color: var(--white);
    font-style: normal;
    font-weight: 600;
  }

  .scene-text .highlight {
    color: var(--gold-light);
    font-style: normal;
  }

  .encounter-badge {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2px;
    padding: 4px 10px;
    border-radius: 2px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }
  .badge-combat { background: rgba(139,32,32,0.4); border: 1px solid var(--red-light); color: #ff8080; }
  .badge-fate { background: rgba(80,40,120,0.4); border: 1px solid #9070d0; color: #c0a0ff; }
  .badge-travel { background: rgba(30,60,30,0.4); border: 1px solid var(--green-light); color: #90d060; }
  .badge-social { background: rgba(40,60,100,0.4); border: 1px solid #5080d0; color: #90b0ff; }
  .badge-treasure { background: rgba(100,80,20,0.4); border: 1px solid var(--gold); color: var(--gold-light); }

  .choices {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .choice-btn {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 14px 20px;
    cursor: pointer;
    text-align: left;
    color: var(--text);
    font-family: 'Crimson Text', serif;
    font-size: 17px;
    line-height: 1.5;
    transition: all 0.2s;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .choice-btn:hover:not(:disabled) {
    border-color: var(--gold);
    background: #1f1810;
    color: var(--white);
    transform: translateX(4px);
  }

  .choice-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .choice-letter {
    font-family: 'Cinzel', serif;
    font-size: 12px;
    color: var(--gold);
    min-width: 20px;
    margin-top: 2px;
    letter-spacing: 1px;
  }

  .choice-hint {
    font-size: 13px;
    color: var(--text-dim);
    font-style: italic;
    margin-top: 2px;
  }

  .outcome-good { border-left: 3px solid var(--green-light); padding-left: 14px; margin: 14px 0; }
  .outcome-bad { border-left: 3px solid var(--red-light); padding-left: 14px; margin: 14px 0; }
  .outcome-neutral { border-left: 3px solid var(--gold); padding-left: 14px; margin: 14px 0; }

  .btn {
    font-family: 'Cinzel', serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 14px 32px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold-light);
    cursor: pointer;
    transition: all 0.2s;
    border-radius: 3px;
  }

  .btn:hover {
    background: var(--gold);
    color: var(--bg);
    box-shadow: 0 0 20px rgba(201,148,58,0.3);
  }

  .btn-danger { border-color: var(--red-light); color: #ff8080; }
  .btn-danger:hover { background: var(--red-light); color: var(--white); }

  .btn-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .end-screen {
    text-align: center;
    padding: 40px 20px;
  }

  .end-title {
    font-family: 'Cinzel', serif;
    font-size: 36px;
    font-weight: 900;
    margin-bottom: 16px;
  }

  .end-title.death { color: var(--red-light); text-shadow: 0 0 30px rgba(192,57,43,0.5); }
  .end-title.victory { color: var(--gold-light); text-shadow: 0 0 30px rgba(201,148,58,0.5); }

  .end-summary {
    font-size: 17px;
    color: var(--text);
    max-width: 500px;
    margin: 0 auto 30px;
    line-height: 1.8;
  }

  .fade-in {
    animation: fadeIn 0.5s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .inventory-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .inv-item {
    font-size: 12px;
    padding: 3px 10px;
    background: #1f1a0f;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-dim);
    font-family: 'Cinzel', serif;
    letter-spacing: 1px;
  }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  @media (max-width: 480px) {
    .char-grid { grid-template-columns: 1fr; }
    .scene-panel { padding: 20px 18px; }
    .hud { font-size: 13px; }
  }
</style>
</head>
<body>
<div id="app">

  <div id="title-screen">
    <div class="title-rune">᚛ ᚔ ᚑ ᚌ ᚏ ᚐ ᚋ ᚏ ᚔ ᚄ ᚛</div>
    <h1>Chronicles<br>of Fate</h1>
    <div class="subtitle">A Tale of Steel &amp; Shadow</div>
    <p style="color:var(--text-dim);max-width:480px;margin:0 auto 40px;font-style:italic;">
      The realm of Vaelthorn stands at the edge of darkness. Ancient evils stir beneath the mountains,
      and the thrones of men grow cold. Only a few bold souls dare answer destiny's call.
    </p>
    <hr class="divider">

    <div class="section-title">Choose Your Champion</div>

    <div class="class-group">
      <div class="class-label">⚔ Brute / Heavy — High strength, low speed &amp; stealth</div>
      <div class="char-grid">
        <div class="char-card" onclick="selectChar('Benacus')" id="card-Benacus">
          <div class="char-name">Benacus</div>
          <div class="char-stats">The Iron Warden of the North. His warhammer has shattered siege gates.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">STR</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SPD</span>
            <div class="stat-pip red-fill"></div><div class="stat-pip red-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
        <div class="char-card" onclick="selectChar('Matthriol')" id="card-Matthriol">
          <div class="char-name">Matthriol</div>
          <div class="char-stats">Berserker of the Ashen Wastes. Battle-rage makes him near unstoppable.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">STR</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SPD</span>
            <div class="stat-pip red-fill"></div><div class="stat-pip red-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="class-group">
      <div class="class-label">🛡 Balanced / Knight — Versatile, no major weakness</div>
      <div class="char-grid">
        <div class="char-card" onclick="selectChar('Adamux')" id="card-Adamux">
          <div class="char-name">Adamux</div>
          <div class="char-stats">Knight-Commander of the Silver Order. Trained for any battlefield.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">STR</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SPD</span>
            <div class="stat-pip green-fill"></div><div class="stat-pip green-fill"></div><div class="stat-pip green-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
        <div class="char-card" onclick="selectChar('Mitchangelo')" id="card-Mitchangelo">
          <div class="char-name">Mitchangelo</div>
          <div class="char-stats">Wandering paladin. Blessed blade, unyielding faith, tactical mind.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">STR</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SPD</span>
            <div class="stat-pip green-fill"></div><div class="stat-pip green-fill"></div><div class="stat-pip green-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="class-group">
      <div class="class-label">🗡 Guard / Police — Great defense, poor at sneaking</div>
      <div class="char-grid">
        <div class="char-card" onclick="selectChar('Klotz')" id="card-Klotz">
          <div class="char-name">Klotz</div>
          <div class="char-stats">City Watch Captain. Iron discipline and a shield that never breaks.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">DEF</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SNK</span>
            <div class="stat-pip red-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
        <div class="char-card" onclick="selectChar('Kochburn')" id="card-Kochburn">
          <div class="char-name">Kochburn</div>
          <div class="char-stats">Royal Gate Warden. Intimidating presence, expert crowd control.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">DEF</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SNK</span>
            <div class="stat-pip red-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="class-group">
      <div class="class-label">🌑 Sneak / Fast — High speed &amp; stealth, fragile in direct combat</div>
      <div class="char-grid">
        <div class="char-card" onclick="selectChar('Sir Josh')" id="card-Sir Josh">
          <div class="char-name">Sir Josh</div>
          <div class="char-stats">Shadow-knight turned rogue. Vanishes before his enemies can blink.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SNK</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">STR</span>
            <div class="stat-pip red-fill"></div><div class="stat-pip red-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
        <div class="char-card" onclick="selectChar('Sir Jace')" id="card-Sir Jace">
          <div class="char-name">Sir Jace</div>
          <div class="char-stats">Phantom of the eastern roads. Poison blade, silent step, quick kill.</div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">SNK</span>
            <div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div><div class="stat-pip filled"></div>
          </div>
          <div class="stat-bar">
            <span style="font-size:11px;color:var(--text-dim);margin-right:4px;font-family:'Cinzel',serif;">STR</span>
            <div class="stat-pip red-fill"></div><div class="stat-pip red-fill"></div><div class="stat-pip"></div><div class="stat-pip"></div><div class="stat-pip"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="btn-row">
      <button class="btn" onclick="startGame()" id="start-btn" disabled>Begin Your Destiny</button>
    </div>
  </div>

  <div id="game-panel">
    <div class="hud">
      <div>
        <div class="hud-name" id="hud-name">—</div>
        <div class="hud-tag" id="hud-class">—</div>
      </div>
      <div class="hud-right">
        <div>
          <div class="hud-tag">Health</div>
          <div class="health-bar" id="health-bar"></div>
        </div>
        <div>
          <div class="hud-tag">Gold</div>
          <div class="gold-count" id="gold-count">⬡ 0</div>
        </div>
        <div id="inv-display" style="display:none;">
          <div class="hud-tag">Items</div>
          <div class="inventory-row" id="inv-row"></div>
        </div>
      </div>
    </div>
    <div id="scene-container"></div>
  </div>

</div>

<script>
const CHARS = {
  'Benacus':     { class:'Brute/Heavy',   hp:5, strength:5, speed:2, sneak:1, defense:3, flavor:'iron warhammer' },
  'Matthriol':   { class:'Brute/Heavy',   hp:5, strength:5, speed:2, sneak:1, defense:3, flavor:'battle-axe' },
  'Adamux':      { class:'Knight',        hp:4, strength:3, speed:3, sneak:2, defense:3, flavor:'longsword and kite shield' },
  'Mitchangelo': { class:'Knight',        hp:4, strength:3, speed:3, sneak:2, defense:3, flavor:'blessed blade' },
  'Klotz':       { class:'Guard',         hp:4, strength:3, speed:2, sneak:1, defense:5, flavor:'tower shield and spear' },
